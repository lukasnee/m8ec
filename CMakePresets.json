{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21
    },
    "configurePresets": [
        {
            "name": "STM32H750",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": ".build",
            "toolchainFile": "extern/STM32H7-DevEBox/cmake/toolchains/arm-none-eabi-gcc.STM32H750.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "PLATFORM": "STM32H750",
                "SEGGER_SYSVIEW_ENABLED": "OFF"
            }
        },
        {
            "name": "STM32H750-dbg",
            "inherits": "STM32H750",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "STM32H750-rel",
            "inherits": "STM32H750",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "STM32H750-sysview",
            "inherits": "STM32H750-rel",
            "cacheVariables": {
                "SEGGER_SYSVIEW_ENABLED": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "STM32H750-dbg",
            "configurePreset": "STM32H750-dbg"
        },
        {
            "name": "STM32H750-rel",
            "configurePreset": "STM32H750-rel"
        },
        {
            "name": "STM32H750-sysview",
            "configurePreset": "STM32H750-sysview"
        }
    ],
    "workflowPresets": [
        {
            "name": "STM32H750-dbg",
            "steps": [
                {
                    "type": "configure",
                    "name": "STM32H750-dbg"
                },
                {
                    "type": "build",
                    "name": "STM32H750-dbg"
                }
            ]
        },
        {
            "name": "STM32H750-rel",
            "steps": [
                {
                    "type": "configure",
                    "name": "STM32H750-rel"
                },
                {
                    "type": "build",
                    "name": "STM32H750-rel"
                }
            ]
        },
        {
            "name": "STM32H750-sysview",
            "steps": [
                {
                    "type": "configure",
                    "name": "STM32H750-sysview"
                },
                {
                    "type": "build",
                    "name": "STM32H750-sysview"
                }
            ]
        }
    ]
}