{
    "version": 10,
    "include": [
        "extern/STM32H7-DevEBox/CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "STM32H750",
            "hidden": true,
            "cacheVariables": {
                "PLATFORM": "STM32H750",
                "SEGGER_SYSVIEW_ENABLED": "OFF"
            }
        },
        {
            "name": "STM32H750-sysview",
            "inherits": "STM32H750-rel",
            "cacheVariables": {
                "SEGGER_SYSVIEW_ENABLED": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "STM32H750-sysview",
            "configurePreset": "STM32H750-sysview"
        }
    ],
    "workflowPresets": [
        {
            "name": "STM32H750-sysview",
            "steps": [
                {
                    "type": "configure",
                    "name": "STM32H750-sysview"
                },
                {
                    "type": "build",
                    "name": "STM32H750-sysview"
                }
            ]
        }
    ]
}