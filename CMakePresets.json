{
    "version": 10,
    "include": [
        "extern/STM32H7-DevEBox/extern/ln/cmake/presets/STM32H750.json"
    ],
    "configurePresets": [
        {
            "name": "toolchain",
            "hidden": true,
            "toolchainFile": "extern/STM32H7-DevEBox/extern/ln/cmake/toolchains/arm-none-eabi-gcc.STM32H750.cmake"
        },
        {
            "name": "m8ec-base",
            "hidden": true,
            "inherits": [
                "build_dir",
                "ninja",
                "toolchain"
            ],
            "cacheVariables": {
                "PLATFORM": "STM32H750",
                "SEGGER_SYSVIEW_ENABLED": "OFF"
            }
        },
        {
            "name": "m8ec-dbg",
            "inherits": [
                "m8ec-base",
                "dbg"
            ]
        },
        {
            "name": "m8ec-rel",
            "inherits": [
                "m8ec-base",
                "rel"
            ]
        },
        {
            "name": "m8ec-sysview",
            "inherits": "m8ec-rel",
            "cacheVariables": {
                "SEGGER_SYSVIEW_ENABLED": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "m8ec-dbg",
            "configurePreset": "m8ec-dbg"
        },
        {
            "name": "m8ec-rel",
            "configurePreset": "m8ec-rel"
        },
        {
            "name": "m8ec-sysview",
            "configurePreset": "m8ec-sysview"
        }
    ],
    "workflowPresets": [
        {
            "name": "m8ec-dbg",
            "steps": [
                {
                    "type": "configure",
                    "name": "m8ec-dbg"
                },
                {
                    "type": "build",
                    "name": "m8ec-dbg"
                }
            ]
        },
        {
            "name": "m8ec-rel",
            "steps": [
                {
                    "type": "configure",
                    "name": "m8ec-rel"
                },
                {
                    "type": "build",
                    "name": "m8ec-rel"
                }
            ]
        },
        {
            "name": "m8ec-sysview",
            "steps": [
                {
                    "type": "configure",
                    "name": "m8ec-sysview"
                },
                {
                    "type": "build",
                    "name": "m8ec-sysview"
                }
            ]
        }
    ]
}