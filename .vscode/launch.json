    "version": "0.2.0",
    "configurations": [
        {
            "name": "m8ec [openocd]",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "configFiles": [
                "../config/openocd.jlink.cfg"
            ],
            "rtos": "FreeRTOS",
            "cwd": "${workspaceRoot}/source",
            "executable": "${workspaceRoot}/.build/source/m8ec",
            // "executable": "${workspaceRoot}/extern/W25Q64_STM32H750VB-DevEBox/.build/bl_iram/bl_iram.elf",
            // ATTENTION: RTOS-awareness does not work when using "symbolFiles" instead of "executable"
            // https://github.com/Marus/cortex-debug/issues/1007
            // "symbolFiles": [
            //     "${workspaceRoot}/.build/source/m8ec",
            //     "${workspaceRoot}/extern/W25Q64_STM32H750VB-DevEBox/.build/bl_iram/bl_iram.elf",
            // ],
            "preAttachCommands": [
                "monitor tpiu config internal itm.fifo uart off 240000000"
            ],
            "svdFile": "${workspaceRoot}/tools/STM32H753.svd",
            "interface": "swd",
            "breakAfterReset": true,
            // "runToEntryPoint": "main"
            // "showDevDebugOutput": "raw",
        },
        {
            "name": "m8ec [jlink]",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "jlink",
            "device": "STM32H750VB",
            "rtos": "FreeRTOS",
            "cwd": "${workspaceRoot}/source",
            "executable": "${workspaceRoot}/.build/source/m8ec",
            // ATTENTION: RTOS-awareness does not work when using "symbolFiles" instead of "executable"
            // "symbolFiles": [
            //     "${workspaceRoot}/.build/source/m8ec",
            //     "${workspaceRoot}/extern/W25Q64_STM32H750VB-DevEBox/.build/bl_iram/bl_iram.elf",
            // ],
            "svdFile": "${workspaceRoot}/tools/STM32H753.svd",
            "interface": "swd",
            "breakAfterReset": true,
            // "runToEntryPoint": "main"
            // "showDevDebugOutput": "raw",
        },
        {
            "name": "m8ec [stlink]",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "configFiles": [
                "../config/openocd.stlink.cfg"
            ],
            "rtos": "FreeRTOS",
            "cwd": "${workspaceRoot}/source",
            "executable": "${workspaceRoot}/.build/source/m8ec",
            // ATTENTION: RTOS-awareness does not work when using "symbolFiles" instead of "executable"
            // "symbolFiles": [
            //     "${workspaceRoot}/.build/source/m8ec",
            //     "${workspaceRoot}/extern/W25Q64_STM32H750VB-DevEBox/.build/bl_iram/bl_iram.elf",
            // ],
            "svdFile": "${workspaceRoot}/tools/STM32H753.svd",
            "interface": "swd",
            "breakAfterReset": true,
            // "runToEntryPoint": "main"
            // "showDevDebugOutput": "raw",
        },
    ]
}